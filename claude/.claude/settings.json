{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(mkfs *)",
      "Bash(dd if=*)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(uname)\" = \"Darwin\" ]; then osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\" sound name \"Ping\"'; else notify-send 'Claude Code' 'Claude Code needs your attention' 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PURPLE_HUB_PATH:-~/obsidian/purple-hub}/tools/claude/hooks/session-end-summary.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".next",
      "dist",
      "build",
      ".turbo",
      ".dart_tool"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "CCSTATUSLINE_WIDTH=400 /Users/jeongyeong-yeon/.asdf/installs/nodejs/24.15.0/bin/node /Users/jeongyeong-yeon/.bun/install/global/node_modules/ccstatusline/dist/ccstatusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": true,
    "context7": true,
    "security-guidance": true,
    "frontend-design": true,
    "playwright": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
